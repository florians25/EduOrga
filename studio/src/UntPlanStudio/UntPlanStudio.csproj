<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- UntPlan Studio (Beta): die Desktop-Anwendung als Browser-Anwendung. Die gesamte Fachlogik kommt aus UntPlan.Core. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>UntPlanStudio</RootNamespace>
    <AssemblyName>UntPlanStudio</AssemblyName>
    <Product>UntPlan Studio</Product>
    <InvariantGlobalization>false</InvariantGlobalization>
    <DefineConstants>$(DefineConstants);UNTPLANSTUDIO</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!-- gemeinsame Update-Prüfung mit UntPlan Web und Mobile (gleiche Logik, eigener Namensraum UntPlanStudio.Dienste) -->
    <Compile Include="..\..\..\web\src\UntPlanWeb\Dienste\Updatepruefung.cs" Link="Dienste\Updatepruefung.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- eigene Datenbank des Studios (studio.db im Datenordner oder MySQL/MariaDB), unabhängig von UntPlan Web -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\UntPlan.Core\UntPlan.Core.csproj" />
    <ProjectReference Include="..\..\..\src\UntPlan.Web.Contracts\UntPlan.Web.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="UntPlanStudio.Tests" />
  </ItemGroup>
  <!--
    Oberfläche (React + Fluent UI, Quelle in studio/client) mit Vite nach wwwroot bauen. wwwroot ist reine Build-Ausgabe
    und nicht eingecheckt. Der Schritt läuft nur, wenn sich Dateien in studio/client geändert haben (Inputs/Outputs).
    Abschalten mit -p:StudioOberflaecheBauen=false (z. B. im Dockerfile, das die Oberfläche in einer eigenen Stufe baut).
  -->
  <PropertyGroup>
    <StudioClient>$(MSBuildProjectDirectory)/../../client</StudioClient>
    <StudioOberflaecheBauen Condition="'$(StudioOberflaecheBauen)' == ''">true</StudioOberflaecheBauen>
  </PropertyGroup>
  <Target Name="StudioOberflaecheBauen" BeforeTargets="BeforeBuild" Condition="'$(StudioOberflaecheBauen)' == 'true' And Exists('$(StudioClient)/package.json')"
          Inputs="@(StudioClientQuelle)" Outputs="$(MSBuildProjectDirectory)/wwwroot/index.html" DependsOnTargets="StudioClientQuellenSammeln">
    <Exec Command="npm --version" StandardOutputImportance="low" ContinueOnError="true">
      <Output TaskParameter="ExitCode" PropertyName="StudioNpmCode" />
    </Exec>
    <Error Condition="'$(StudioNpmCode)' != '0'" Text="Für die Oberfläche des Studios wird Node.js 22 (npm) benötigt: studio/client mit „npm ci &amp;&amp; npm run build“ bauen oder Node.js installieren." />
    <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="$(StudioClient)" Condition="!Exists('$(StudioClient)/node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(StudioClient)" />
    <ItemGroup>
      <Content Include="wwwroot/**" Exclude="@(Content)" />
    </ItemGroup>
  </Target>
  <Target Name="StudioClientQuellenSammeln">
    <ItemGroup>
      <StudioClientQuelle Include="$(StudioClient)/src/**;$(StudioClient)/public/**;$(StudioClient)/index.html;$(StudioClient)/package.json;$(StudioClient)/vite.config.ts;$(StudioClient)/tsconfig.json;$(MSBuildProjectDirectory)/../../../design/tokens.css" />
    </ItemGroup>
  </Target>
</Project>
