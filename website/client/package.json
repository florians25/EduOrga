{
  "name": "eduorga-website-client",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Oberfläche der EduOrga Website (React, TypeScript). Der Build landet in ../src/EduOrgaWebsite/wwwroot.",
  "scripts": {
    "vorbereiten": "node scripts/vorbereiten.mjs",
    "dev": "node scripts/vorbereiten.mjs && vite",
    "build": "node scripts/vorbereiten.mjs && tsc --noEmit && vite build",
    "typecheck": "node scripts/vorbereiten.mjs && tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.7"
  }
}
