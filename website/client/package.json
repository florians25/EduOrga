{
  "name": "eduorga-website-client",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Oberfläche der EduOrga Website (React, TypeScript, Fluent UI). Der Build landet in ../src/EduOrgaWebsite/wwwroot.",
  "scripts": {
    "vorbereiten": "node scripts/vorbereiten.mjs",
    "dev": "node scripts/vorbereiten.mjs && vite",
    "build": "node scripts/vorbereiten.mjs && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fluentui/react-components": "^9.74.9",
    "@fluentui/react-icons": "^2.0.344",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.7"
  }
}
